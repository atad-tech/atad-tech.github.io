---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import Icon from "@/components/Icon.astro";
import { SERVICES } from "@/data/services";
import { CONTACT, SOCIAL, whatsappLink } from "@/config/site";
import { breadcrumbs } from "@/lib/schema";

const crumbs = [{ name: "عتاد", path: "/" }, { name: "تواصل معنا", path: "/contact/" }];
---
<BaseLayout
  title="تواصل معنا | عتاد ATAD"
  description="تواصل مع عتاد على واتساب أو فيسبوك أو إنستجرام، واحكيلنا عن مشروعك ونرجعلك بتصور وسعر خلال يوم عمل."
  path="/contact/"
  schema={[breadcrumbs(crumbs)]}
>
  <PageHero title="احكيلنا عن مشروعك" lead="املا البيانات دي وهتتبعتلنا رسالة جاهزة على واتساب، أو كلمنا مباشرة. بنرد خلال يوم عمل." crumbs={crumbs} />

  <section class="section">
    <div class="container contact">
      <form class="card form" id="contact-form" data-wa-number={CONTACT.whatsapp}>
        <h2>اطلب عرض سعر</h2>
        <label>اسمك<input name="name" autocomplete="name" required /></label>
        <label>اسم النشاط أو الشركة<input name="company" autocomplete="organization" /></label>
        <label>الخدمة اللي محتاجها
          <select name="service" required>
            <option value="">اختار خدمة</option>
            {SERVICES.map((s) => <option value={s.name}>{s.name}</option>)}
            <option value="أكتر من خدمة / مش متأكد">أكتر من خدمة / مش متأكد</option>
          </select>
        </label>
        <label>احكيلنا باختصار<textarea name="details" rows="4" placeholder="فكرة المشروع، الميزانية التقريبية، الميعاد اللي محتاجه فيه…"></textarea></label>
        <button class="btn btn--wa btn--lg" type="submit"><Icon name="whatsapp" size={20} />ابعت على واتساب</button>
        <p class="fine">مش بنحفظ أي بيانات على الموقع. الرسالة بتتفتح في واتساب وإنت اللي بتبعتها.</p>
      </form>

      <aside class="ways">
        <a class="card way" href={whatsappLink("أهلًا عتاد")} rel="noopener" data-wa="contact-direct">
          <span class="icon-badge"><Icon name="whatsapp" /></span>
          <div><h3>واتساب</h3><p dir="ltr">{CONTACT.phoneDisplay}</p></div>
        </a>
        <a class="card way" href={`tel:${CONTACT.phoneE164}`}>
          <span class="icon-badge"><Icon name="phone" /></span>
          <div><h3>مكالمة</h3><p dir="ltr">{CONTACT.phoneDisplay}</p></div>
        </a>
        <a class="card way" href={SOCIAL.facebook} rel="noopener" target="_blank">
          <span class="icon-badge"><Icon name="facebook" /></span>
          <div><h3>فيسبوك</h3><p>ابعتلنا رسالة على الصفحة</p></div>
        </a>
        <a class="card way" href={SOCIAL.instagram} rel="noopener" target="_blank">
          <span class="icon-badge"><Icon name="instagram" /></span>
          <div><h3>إنستجرام</h3><p dir="ltr">@atad.tech</p></div>
        </a>
      </aside>
    </div>
  </section>
</BaseLayout>

<script>
  import { trackLead, withSource } from "@/scripts/lead";
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const v = (k: string) => String(fd.get(k) ?? "").trim();
    const text = withSource([
      "أهلًا عتاد، عايز عرض سعر:",
      `• الاسم: ${v("name")}`,
      v("company") && `• النشاط: ${v("company")}`,
      `• الخدمة: ${v("service")}`,
      v("details") && `• التفاصيل: ${v("details")}`,
    ].filter(Boolean).join("\n"));
    trackLead("contact-form");
    window.open(`https://wa.me/${form.dataset["waNumber"]}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
  });
</script>

<style>
  .contact { display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: start; }
  .form { display: grid; gap: 14px; padding: 28px; border-top: 4px solid var(--cyan); }
  .form h2 { font-size: 22px; margin: 0; }
  label { display: grid; gap: 6px; font-weight: 600; font-size: 14.5px; }
  input, select, textarea { font: 400 16px var(--font-body); color: var(--ink); background: var(--bg); border: 1.5px solid var(--line); border-radius: 9px; padding: 11px 12px; width: 100%; }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--cyan); box-shadow: 0 0 0 3px var(--cyan-soft); }
  .fine { color: var(--muted); font-size: 13px; margin: 0; text-align: center; }
  .ways { display: grid; gap: 12px; }
  .way { display: flex; gap: 14px; align-items: center; text-decoration: none; padding: 16px; transition: border-color .15s; }
  .way:hover { border-color: var(--cyan); }
  .way .icon-badge { margin: 0; flex: none; }
  .way h3 { margin: 0; font-size: 17px; }
  .way p { margin: 0; text-align: start; }
  @media (max-width: 860px) { .contact { grid-template-columns: 1fr; } }
</style>

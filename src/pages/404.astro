  <PageHero title="الصفحة دي مش موجودة" lead="ممكن الرابط اتغيّر أو اتكتب غلط. جرّب من هنا:">
    <div class="btn-row">
      <a class="btn btn--primary btn--lg" href={href("/")}>الصفحة الرئيسية</a>
      <a class="btn btn--ghost btn--lg" href={href("/services/")}>كل الخدمات</a>
    </div>
  </PageHero>
</BaseLayout>

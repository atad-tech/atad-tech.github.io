---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
---
<BaseLayout title="شروط الاستخدام | عتاد ATAD" description="شروط استخدام موقع عتاد ATAD والأسعار المعروضة عليه." path="/terms/">
  <PageHero title="شروط الاستخدام" lead="آخر تحديث: أكتوبر 2026" />
  <section class="section">
    <div class="container prose">
      <h2>الأسعار والحاسبة</h2>
      <p>الأسعار اللي في الحاسبة وصفحات الموقع تقديرية، وهدفها تديك فكرة عن الميزانية. السعر النهائي والمدة بيتحددوا في عرض سعر مكتوب بعد ما نفهم تفاصيل مشروعك، وهو اللي بيتعمل بيه.</p>
      <h2>العروض والخصومات</h2>
      <p>أي خصم معروض على الموقع ساري لحد التاريخ المكتوب جنبه، وعلى أول مشروع للعميل، إلا لو عرض السعر المكتوب قال غير كده.</p>
      <h2>الملكية</h2>
      <p>محتوى الموقع وتصميمه ولوجو عتاد ملك عتاد ATAD. ملكية شغل العملاء بتتحدد في الاتفاق الخاص بكل مشروع.</p>
      <h2>الروابط الخارجية</h2>
      <p>الموقع فيه روابط لواتساب وفيسبوك وإنستجرام، وكل منصة ليها شروطها وسياسة خصوصيتها.</p>
    </div>
  </section>
</BaseLayout>

---
/**
 * بتدفع إزاي: شريط نور متقسم بنسب الدفعات (30 / 40 / 30) وكل دفعة تحتها،
 * وبعدين 3 كروت: كل بند بسعره، نسخة الانطلاق، وجاهز يبيع.
 * بيظهر في الرئيسية وصفحة الأسعار وصفحات البرمجة.
 */
import Icon from "./Icon.astro";
import { PAYMENT_PLAN } from "@/config/pricing";
import { href } from "@/lib/url";

interface Props { alt?: boolean }
const details = [
  "دفعة صغيرة تبدأ بيها، ونبدأ التصميم وتشوفه قبل أي برمجة.",
  "بعد ما تجرّب النسخة التجريبية بنفسك على موبايلك أو جهازك.",
  "بعد الرفع على المتاجر أو الإطلاق، والكود والحسابات كلها باسمك.",
];
const extras = [
  { icon: "grid" as const, t: "كل بند مكتوب بسعره", d: "التطبيق، لوحة التحكم، الدفع، التوصيل… كل حاجة بسعرها، والرفع على المتاجر وشهر الدعم الفني مشمولين." },
  { icon: "target" as const, t: "ابدأ بنسخة انطلاق (MVP)", d: "لو الميزانية ممسوكة، نبدأ بالمميزات الأساسية تنزل بيها السوق وتبدأ تبيع، ونكمّل الباقي في مرحلة تانية." },
  { icon: "megaphone" as const, t: "جاهز يجيب عملاء", d: "بيتسلّم متجهّز للإعلانات والتتبع، وفريق الإعلانات عندنا يقدر يطلق حملاتك ويجيبلك أول عملاء." },
];
---
<section class="cosmos cosmos--violet pay" aria-labelledby="pay-h">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow">عرض السعر عندنا</p>
      <h2 id="pay-h">بتدفع على شغل <span class="grad">شافته عينك</span></h2>
      <p>السعر مش رقم واحد ترميه وتستنى. بنفكّكهولك بند بند، وبتدفعه على {PAYMENT_PLAN.length} مراحل، وكل مرحلة بعد ما تشوف اللي اتعمل.</p>
    </div>

    <div class="track" data-reveal>
      <ol class="segs">
        {PAYMENT_PLAN.map((p, i) => (
          <li class={`seg s${i}`}>
            <div class="bar"><span></span></div>
            <b class="pct">{p.pct}%</b>
            <h3>{p.when}</h3>
            <p>{details[i]}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="grid grid-3 extras" data-reveal="stagger">
      {extras.map((e) => (
        <div class="gcard" data-tilt>
          <span class="orb"><Icon name={e.icon} size={24} /></span>
          <h3>{e.t}</h3>
          <p>{e.d}</p>
        </div>
      ))}
    </div>
    <p class="cta"><a class="btn btn--primary btn--lg" href={href("/#calc")}>شوف عرض سعرك بالتفصيل</a></p>
  </div>
</section>

<style>
  .track { margin-bottom: 34px; }
  .segs { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 30fr 40fr 30fr; gap: 10px; }
  .bar { height: 12px; border-radius: 99px; background: rgba(255,255,255,.07); overflow: hidden; margin-bottom: 20px; box-shadow: inset 0 0 0 1px rgba(255,255,255,.06); }
  .bar span { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, #12c2e9, #a78bfa); box-shadow: 0 0 18px rgba(18,194,233,.8); transition: width 1.1s cubic-bezier(.2,.7,.2,1); }
  .s1 .bar span { background: linear-gradient(90deg, #a78bfa, #f0abfc); box-shadow: 0 0 18px rgba(167,139,250,.8); transition-delay: .35s; }
  .s2 .bar span { background: linear-gradient(90deg, #f0abfc, #12c2e9); transition-delay: .7s; }
  :global(.in) .bar span, :global(html:not(.fx)) .bar span { width: 100%; }
  .pct { display: block; font: 700 clamp(34px, 4vw, 48px)/1 var(--font-display); background: linear-gradient(180deg, #fff, #7dd3fc); -webkit-background-clip: text; background-clip: text; color: transparent; margin-bottom: 8px; }
  .s1 .pct { background-image: linear-gradient(180deg, #fff, #c4b5fd); }
  .seg h3 { color: #fff; font-size: 18px; margin-bottom: 6px; }
  .seg p { color: #9fb0c7; margin: 0; font-size: 15px; padding-inline-end: 12px; }
  .cta { text-align: center; margin: 32px 0 0; }
  @media (max-width: 760px) {
    .segs { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .bar { margin-bottom: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .bar span { width: 100%; transition: none; } }
  @media print { .bar span { width: 100% !important; } }
</style>
